        uk:installer_title) printf '%s' 'Інсталятор SoundCurrent';;
        uk:install_title) printf '%s' 'Встановити або оновити SoundCurrent';;
        uk:interactive) printf '%s' 'Запустіть цей інсталятор інтерактивно в терміналі.';;
        uk:continue) printf '%s' 'Продовжити? [y/N] ';;
        uk:package_file) printf '%s' 'Укажіть наявний пакет після --package-file.';;
        uk:unknown_option) printf '%s' 'Невідомий параметр.';;
        uk:language_required) printf '%s' 'Укажіть код мови після --language.';;
        uk:usage) printf '%s' 'Використання: bash %1 [--language TAG] [--dry-run|--download-only] [--package-file PATH]';;
        uk:architecture) printf '%s' 'Ці перевірені пакети потребують комп’ютера x86-64.';;
        uk:identify) printf '%s' 'Не вдалося визначити цей дистрибутив.';;
        uk:dry_run) printf '%s' 'Продукт: %1 %2
Дистрибутив: %3
Пакет: %4
SHA256: %5
Інсталятор: %6';;
        uk:manager) printf '%s' 'У цій системі немає %1.';;
        uk:newer) printf '%s' 'Новішу версію %1 (%2) вже встановлено. Її збережено; цей інсталятор Linux надає версію %3.';;
        uk:sha_required) printf '%s' 'Потрібна програма sha256sum.';;
        uk:quit) printf '%s' 'Перед оновленням завершіть роботу запущеної програми SoundCurrent за допомогою «Вийти з програми». Закриття вікна залишає програму запущеною.';;
        uk:download_confirm) printf '%s' 'Завантажити та перевірити %1 %2 для %3? Встановлення не виконуватиметься.';;
        uk:install_confirm) printf '%s' 'Встановити або оновити %1 %2 у системі %3? Ваші пресети й профілі буде збережено. Менеджер пакетів встановлює залежності та додає значок у меню програм. Потрібне схвалення адміністратора. Одночасно має працювати лише один еквалайзер.';;
        uk:download_tool) printf '%s' 'Спочатку встановіть curl або wget.';;
        uk:verification) printf '%s' 'Перевірка пакета не вдалася. Нічого не встановлено.';;
        uk:exists) printf '%s' 'Уже існує: %1';;
        uk:saved) printf '%s' 'Перевірений пакет збережено в %1';;
        uk:glibc) printf '%s' 'Цей пакет потребує glibc %1 або новішої версії; у цій системі встановлено версію %2. Нічого не встановлено.';;
        uk:installed) printf '%s' '%1 %2 встановлено. Відкрийте програму з меню програм. Після оновлення скористайтеся «Вийти з програми» та відкрийте програму знову. Оновлення програми не потребує її видалення або перезапуску системи.';;
        ru:enterprise) printf '%s' 'Текущий пакет RPM для корпоративных систем требует RHEL 10 или совместимого производного дистрибутива версии 10.';;
        ru:fedora) printf '%s' 'Текущий пакет Fedora требует Fedora 44 или более новой версии.';;
        ru:unsupported) printf '%s' 'Для этого дистрибутива пока нет проверенного пакета. Поддерживаемые пакеты доступны в выпусках на GitHub.';;
        ru:installer_title) printf '%s' 'Установщик SoundCurrent';;
        ru:install_title) printf '%s' 'Установить или обновить SoundCurrent';;
        ru:interactive) printf '%s' 'Запустите этот установщик интерактивно в терминале.';;
        ru:continue) printf '%s' 'Продолжить? [y/N] ';;
        ru:package_file) printf '%s' 'Укажите существующий пакет после --package-file.';;
        ru:unknown_option) printf '%s' 'Неизвестный параметр.';;
        ru:language_required) printf '%s' 'Укажите код языка после --language.';;
        ru:usage) printf '%s' 'Использование: bash %1 [--language TAG] [--dry-run|--download-only] [--package-file PATH]';;
        ru:architecture) printf '%s' 'Эти проверенные пакеты требуют компьютера x86-64.';;
        ru:identify) printf '%s' 'Не удалось определить этот дистрибутив.';;
        ru:dry_run) printf '%s' 'Продукт: %1 %2
Дистрибутив: %3
Пакет: %4
SHA256: %5
Установщик: %6';;
        ru:manager) printf '%s' 'В этой системе отсутствует %1.';;
        ru:newer) printf '%s' 'Более новая версия %1 (%2) уже установлена. Она сохранена; этот установщик Linux предоставляет версию %3.';;
        ru:sha_required) printf '%s' 'Требуется программа sha256sum.';;
        ru:quit) printf '%s' 'Перед обновлением завершите работу запущенного приложения SoundCurrent с помощью «Выйти из приложения». Закрытие окна оставляет приложение работающим.';;
        ru:download_confirm) printf '%s' 'Скачать и проверить %1 %2 для %3? Установка выполняться не будет.';;
        ru:install_confirm) printf '%s' 'Установить или обновить %1 %2 в системе %3? Ваши пресеты и профили сохраняются. Менеджер пакетов устанавливает зависимости и добавляет значок в меню приложений. Требуется разрешение администратора. Одновременно должен работать только один эквалайзер.';;
        ru:download_tool) printf '%s' 'Сначала установите curl или wget.';;
        ru:verification) printf '%s' 'Проверка пакета не удалась. Ничего не установлено.';;
        ru:exists) printf '%s' 'Уже существует: %1';;
        ru:saved) printf '%s' 'Проверенный пакет сохранён в %1';;
        ru:glibc) printf '%s' 'Этот пакет требует glibc %1 или более новой версии; в этой системе установлена версия %2. Ничего не установлено.';;
        ru:installed) printf '%s' '%1 %2 установлен. Откройте приложение из меню приложений. После обновления воспользуйтесь «Выйти из приложения» и откройте приложение снова. Обновление приложения не требует его удаления или перезапуска системы.';;
        he:enterprise) printf '%s' 'חבילת RPM הנוכחית למערכות ארגוניות דורשת RHEL 10 או הפצה נגזרת תואמת בגרסה 10.';;
        he:fedora) printf '%s' 'חבילת Fedora הנוכחית דורשת Fedora 44 או גרסה חדשה יותר.';;
        he:unsupported) printf '%s' 'עדיין אין חבילה שנבדקה עבור הפצה זו. חבילות נתמכות מופיעות במהדורות ב־GitHub.';;
        he:installer_title) printf '%s' 'מתקין SoundCurrent';;
        he:install_title) printf '%s' 'התקנה או עדכון של SoundCurrent';;
        he:interactive) printf '%s' 'יש להריץ מתקין זה באופן אינטראקטיבי במסוף.';;
        he:continue) printf '%s' 'להמשיך? [y/N] ';;
        he:package_file) printf '%s' 'יש לציין חבילה קיימת אחרי --package-file.';;
        he:unknown_option) printf '%s' 'אפשרות לא מוכרת.';;
        he:language_required) printf '%s' 'יש לציין קוד שפה אחרי --language.';;
        he:usage) printf '%s' 'שימוש: bash %1 [--language TAG] [--dry-run|--download-only] [--package-file PATH]';;
        he:architecture) printf '%s' 'חבילות אלה שנבדקו דורשות מחשב x86-64.';;
        he:identify) printf '%s' 'לא ניתן לזהות הפצה זו.';;
        he:dry_run) printf '%s' 'מוצר: %1 %2
הפצה: %3
חבילה: %4
SHA256: %5
מתקין: %6';;
        he:manager) printf '%s' 'במערכת זו חסר %1.';;
        he:newer) printf '%s' 'גרסה חדשה יותר של %1 (%2) כבר מותקנת. היא נשמרה; מתקין Linux זה מספק את גרסה %3.';;
        he:sha_required) printf '%s' 'נדרש sha256sum.';;
        he:quit) printf '%s' 'לפני העדכון יש לסגור את אפליקציית SoundCurrent הפעילה באמצעות «יציאה מהאפליקציה». סגירת החלון משאירה את האפליקציה פועלת.';;
        he:download_confirm) printf '%s' 'להוריד ולאמת את %1 %2 עבור %3? לא תבוצע התקנה.';;
        he:install_confirm) printf '%s' 'להתקין או לעדכן את %1 %2 במערכת %3? הקביעות המוגדרות מראש והפרופילים נשמרים. מנהל החבילות מתקין תלויות ומוסיף סמל לתפריט האפליקציות. נדרש אישור מנהל מערכת. רק אקולייזר אחד צריך לפעול בכל פעם.';;
        he:download_tool) printf '%s' 'יש להתקין תחילה curl או wget.';;
        he:verification) printf '%s' 'אימות החבילה נכשל. לא הותקן דבר.';;
        he:exists) printf '%s' 'כבר קיים: %1';;
        he:saved) printf '%s' 'החבילה שאומתה נשמרה ב־%1';;
        he:glibc) printf '%s' 'חבילה זו דורשת glibc %1 או גרסה חדשה יותר; במערכת זו מותקנת גרסה %2. לא הותקן דבר.';;
        he:installed) printf '%s' '%1 %2 הותקן. יש לפתוח את האפליקציה מתפריט האפליקציות. לאחר עדכון יש להשתמש ב־«יציאה מהאפליקציה» ולפתוח שוב את האפליקציה. עדכון האפליקציה אינו דורש הסרה או הפעלה מחדש של המערכת.';;
        fa:enterprise) printf '%s' 'بستهٔ RPM فعلی برای سیستم‌های سازمانی به RHEL 10 یا یک توزیع مشتق‌شدهٔ سازگار با نسخهٔ 10 نیاز دارد.';;
        fa:fedora) printf '%s' 'بستهٔ Fedora فعلی به Fedora 44 یا نسخهٔ جدیدتر نیاز دارد.';;
        fa:unsupported) printf '%s' 'هنوز بستهٔ بررسی‌شده‌ای برای این توزیع وجود ندارد. برای بسته‌های پشتیبانی‌شده، انتشارهای GitHub را ببینید.';;
        fa:installer_title) printf '%s' 'نصب‌کنندهٔ SoundCurrent';;
        fa:install_title) printf '%s' 'نصب یا به‌روزرسانی SoundCurrent';;
        fa:interactive) printf '%s' 'این نصب‌کننده را به‌صورت تعاملی در یک پایانه اجرا کنید.';;
        fa:continue) printf '%s' 'ادامه می‌دهید؟ [y/N] ';;
        fa:package_file) printf '%s' 'پس از --package-file یک بستهٔ موجود را مشخص کنید.';;
        fa:unknown_option) printf '%s' 'گزینهٔ ناشناخته.';;
        fa:language_required) printf '%s' 'پس از --language یک کد زبان مشخص کنید.';;
        fa:usage) printf '%s' 'نحوهٔ استفاده: bash %1 [--language TAG] [--dry-run|--download-only] [--package-file PATH]';;
        fa:architecture) printf '%s' 'این بسته‌های بررسی‌شده به رایانهٔ x86-64 نیاز دارند.';;
        fa:identify) printf '%s' 'شناسایی این توزیع ممکن نیست.';;
        fa:dry_run) printf '%s' 'محصول: %1 %2
توزیع: %3
بسته: %4
SHA256: %5
نصب‌کننده: %6';;
        fa:manager) printf '%s' 'این سیستم فاقد %1 است.';;
        fa:newer) printf '%s' 'نسخهٔ جدیدتری از %1 (%2) از قبل نصب شده است. آن نسخه حفظ شد؛ این نصب‌کنندهٔ Linux نسخهٔ %3 را ارائه می‌کند.';;
        fa:sha_required) printf '%s' 'sha256sum لازم است.';;
        fa:quit) printf '%s' 'پیش از به‌روزرسانی، برنامهٔ در حال اجرای SoundCurrent را با «خروج از برنامه» ببندید. بستن پنجره، برنامه را در حال اجرا نگه می‌دارد.';;
        fa:download_confirm) printf '%s' '%1 %2 برای %3 دریافت و تأیید شود؟ نصبی انجام نخواهد شد.';;
        fa:install_confirm) printf '%s' '%1 %2 روی %3 نصب یا به‌روزرسانی شود؟ پیش‌تنظیم‌ها و پروفایل‌های شما حفظ می‌شوند. مدیر بسته وابستگی‌ها را نصب می‌کند و یک نماد به فهرست برنامه‌ها اضافه می‌کند. تأیید مدیر سیستم لازم است. هر بار فقط یک اکولایزر باید در حال اجرا باشد.';;
        fa:download_tool) printf '%s' 'ابتدا curl یا wget را نصب کنید.';;
        fa:verification) printf '%s' 'تأیید بسته ناموفق بود. چیزی نصب نشد.';;
        fa:exists) printf '%s' 'از قبل وجود دارد: %1';;
        fa:saved) printf '%s' 'بستهٔ تأییدشده در %1 ذخیره شد';;
        fa:glibc) printf '%s' 'این بسته به glibc %1 یا نسخهٔ جدیدتر نیاز دارد؛ این سیستم نسخهٔ %2 را دارد. چیزی نصب نشد.';;
        fa:installed) printf '%s' '%1 %2 نصب شد. برنامه را از فهرست برنامه‌ها باز کنید. پس از به‌روزرسانی از «خروج از برنامه» استفاده کنید و برنامه را دوباره باز کنید. برای به‌روزرسانی برنامه نیازی به حذف نصب یا راه‌اندازی مجدد سیستم نیست.';;
        zh-Hans:enterprise) printf '%s' '当前企业版 RPM 需要 RHEL 10 或兼容的版本 10 衍生发行版。';;
        zh-Hans:fedora) printf '%s' '当前 Fedora 软件包需要 Fedora 44 或更新版本。';;
        zh-Hans:unsupported) printf '%s' '此发行版尚无经过验证的软件包。请查看 GitHub 发布页面，了解受支持的构建版本。';;
        zh-Hans:installer_title) printf '%s' 'SoundCurrent 安装程序';;
        zh-Hans:install_title) printf '%s' '安装或更新 SoundCurrent';;
        zh-Hans:interactive) printf '%s' '请在终端中以交互方式运行此安装程序。';;
        zh-Hans:continue) printf '%s' '继续？[y/N] ';;
        zh-Hans:package_file) printf '%s' '请在 --package-file 后指定一个现有的软件包。';;
        zh-Hans:unknown_option) printf '%s' '未知选项。';;
        zh-Hans:language_required) printf '%s' '请在 --language 后指定语言标签。';;
        zh-Hans:usage) printf '%s' '用法：bash %1 [--language TAG] [--dry-run|--download-only] [--package-file PATH]';;
        zh-Hans:architecture) printf '%s' '这些经过验证的软件包需要 x86-64 计算机。';;
        zh-Hans:identify) printf '%s' '无法识别此发行版。';;
        zh-Hans:dry_run) printf '%s' '产品：%1 %2
发行版：%3
软件包：%4
SHA256：%5
安装程序：%6';;
        zh-Hans:manager) printf '%s' '此系统缺少 %1。';;
        zh-Hans:newer) printf '%s' '已安装较新版本的 %1（%2）。该版本已保留；此 Linux 安装程序提供版本 %3。';;
        zh-Hans:sha_required) printf '%s' '需要 sha256sum。';;
        zh-Hans:quit) printf '%s' '更新前，请使用«退出应用»退出正在运行的 SoundCurrent 应用。关闭窗口会让应用继续运行。';;
        zh-Hans:download_confirm) printf '%s' '是否为 %3 下载并验证 %1 %2？不会进行安装。';;
        zh-Hans:install_confirm) printf '%s' '是否在 %3 上安装或更新 %1 %2？您的预设和配置文件将被保留。软件包管理器会安装依赖项并添加应用菜单图标。需要管理员授权。一次只能运行一个均衡器。';;
        zh-Hans:download_tool) printf '%s' '请先安装 curl 或 wget。';;
        zh-Hans:verification) printf '%s' '软件包验证失败。未安装任何内容。';;
        zh-Hans:exists) printf '%s' '已存在：%1';;
        zh-Hans:saved) printf '%s' '经过验证的软件包已保存到 %1';;
        zh-Hans:glibc) printf '%s' '此软件包需要 glibc %1 或更新版本；此系统的版本为 %2。未安装任何内容。';;
        zh-Hans:installed) printf '%s' '已安装 %1 %2。请从应用菜单打开它。更新后，请使用«退出应用»退出，然后重新打开应用。应用更新不需要卸载或重启系统。';;
        zh-Hant:enterprise) printf '%s' '目前的企業版 RPM 需要 RHEL 10 或相容的版本 10 衍生發行版。';;
        zh-Hant:fedora) printf '%s' '目前的 Fedora 套件需要 Fedora 44 或更新版本。';;
        zh-Hant:unsupported) printf '%s' '此發行版尚無經過驗證的套件。請查看 GitHub 發布頁面，了解支援的建置版本。';;
        zh-Hant:installer_title) printf '%s' 'SoundCurrent 安裝程式';;
        zh-Hant:install_title) printf '%s' '安裝或更新 SoundCurrent';;
        zh-Hant:interactive) printf '%s' '請在終端機中以互動方式執行此安裝程式。';;
        zh-Hant:continue) printf '%s' '繼續？[y/N] ';;
        zh-Hant:package_file) printf '%s' '請在 --package-file 後指定一個現有的套件。';;
        zh-Hant:unknown_option) printf '%s' '未知選項。';;
        zh-Hant:language_required) printf '%s' '請在 --language 後指定語言標籤。';;
        zh-Hant:usage) printf '%s' '用法：bash %1 [--language TAG] [--dry-run|--download-only] [--package-file PATH]';;
        zh-Hant:architecture) printf '%s' '這些經過驗證的套件需要 x86-64 電腦。';;
        zh-Hant:identify) printf '%s' '無法識別此發行版。';;
        zh-Hant:dry_run) printf '%s' '產品：%1 %2
發行版：%3
套件：%4
SHA256：%5
安裝程式：%6';;
        zh-Hant:manager) printf '%s' '此系統缺少 %1。';;
        zh-Hant:newer) printf '%s' '已安裝較新版本的 %1（%2）。該版本已保留；此 Linux 安裝程式提供版本 %3。';;
        zh-Hant:sha_required) printf '%s' '需要 sha256sum。';;
        zh-Hant:quit) printf '%s' '更新前，請使用«結束應用程式»結束正在執行的 SoundCurrent 應用程式。關閉視窗會讓應用程式繼續執行。';;
        zh-Hant:download_confirm) printf '%s' '是否為 %3 下載並驗證 %1 %2？不會進行安裝。';;
        zh-Hant:install_confirm) printf '%s' '是否在 %3 上安裝或更新 %1 %2？您的預設與設定檔將會保留。套件管理員會安裝相依套件並新增應用程式選單圖示。需要管理員授權。一次只能執行一個等化器。';;
        zh-Hant:download_tool) printf '%s' '請先安裝 curl 或 wget。';;
        zh-Hant:verification) printf '%s' '套件驗證失敗。未安裝任何內容。';;
        zh-Hant:exists) printf '%s' '已存在：%1';;
        zh-Hant:saved) printf '%s' '已驗證的套件已儲存至 %1';;
        zh-Hant:glibc) printf '%s' '此套件需要 glibc %1 或更新版本；此系統的版本為 %2。未安裝任何內容。';;
        zh-Hant:installed) printf '%s' '已安裝 %1 %2。請從應用程式選單開啟。更新後，請使用«結束應用程式»結束，然後重新開啟應用程式。應用程式更新不需要解除安裝或重新啟動系統。';;
        ja:enterprise) printf '%s' '現在のエンタープライズ向け RPM には、RHEL 10 または互換性のあるバージョン 10 の派生ディストリビューションが必要です。';;
        ja:fedora) printf '%s' '現在の Fedora パッケージには Fedora 44 以降が必要です。';;
        ja:unsupported) printf '%s' 'このディストリビューション用の検証済みパッケージはまだありません。対応するビルドについては GitHub のリリースページをご覧ください。';;
        ja:installer_title) printf '%s' 'SoundCurrent インストーラー';;
        ja:install_title) printf '%s' 'SoundCurrent のインストールまたは更新';;
        ja:interactive) printf '%s' 'このインストーラーを端末で対話的に実行してください。';;
        ja:continue) printf '%s' '続行しますか？ [y/N] ';;
        ja:package_file) printf '%s' '--package-file の後に既存のパッケージを指定してください。';;
        ja:unknown_option) printf '%s' '不明なオプションです。';;
        ja:language_required) printf '%s' '--language の後に言語タグを指定してください。';;
        ja:usage) printf '%s' '使用方法: bash %1 [--language TAG] [--dry-run|--download-only] [--package-file PATH]';;
        ja:architecture) printf '%s' 'これらの検証済みパッケージには x86-64 コンピューターが必要です。';;
        ja:identify) printf '%s' 'このディストリビューションを識別できません。';;
        ja:dry_run) printf '%s' '製品: %1 %2
ディストリビューション: %3
パッケージ: %4
SHA256: %5
インストーラー: %6';;
        ja:manager) printf '%s' 'このシステムには %1 がありません。';;
        ja:newer) printf '%s' 'より新しい %1（%2）がすでにインストールされています。そのバージョンを保持しました。この Linux インストーラーが提供するバージョンは %3 です。';;
        ja:sha_required) printf '%s' 'sha256sum が必要です。';;
        ja:quit) printf '%s' '更新前に«アプリを終了»を使って、実行中の SoundCurrent アプリを終了してください。ウィンドウを閉じてもアプリは実行を続けます。';;
        ja:download_confirm) printf '%s' '%3 用の %1 %2 をダウンロードして検証しますか？インストールは行いません。';;
        ja:install_confirm) printf '%s' '%3 に %1 %2 をインストールまたは更新しますか？プリセットとプロファイルは保持されます。パッケージマネージャーが依存パッケージをインストールし、アプリケーションメニューにアイコンを追加します。管理者の承認が必要です。同時に実行するイコライザーは一つだけにしてください。';;
        ja:download_tool) printf '%s' '先に curl または wget をインストールしてください。';;
        ja:verification) printf '%s' 'パッケージの検証に失敗しました。何もインストールしていません。';;
        ja:exists) printf '%s' 'すでに存在します: %1';;
        ja:saved) printf '%s' '検証済みパッケージを %1 に保存しました。';;
        ja:glibc) printf '%s' 'このパッケージには glibc %1 以降が必要です。このシステムのバージョンは %2 です。何もインストールしていません。';;
        ja:installed) printf '%s' '%1 %2 をインストールしました。アプリケーションメニューから開いてください。更新後は«アプリを終了»を使って終了し、再度開いてください。アプリの更新にアンインストールやシステムの再起動は不要です。';;
        ko:enterprise) printf '%s' '현재 기업용 RPM에는 RHEL 10 또는 호환되는 버전 10 파생 배포판이 필요합니다.';;
        ko:fedora) printf '%s' '현재 Fedora 패키지에는 Fedora 44 이상이 필요합니다.';;
        ko:unsupported) printf '%s' '이 배포판에는 아직 검증된 패키지가 없습니다. 지원되는 빌드는 GitHub 릴리스 페이지에서 확인하세요.';;
        ko:installer_title) printf '%s' 'SoundCurrent 설치 프로그램';;
        ko:install_title) printf '%s' 'SoundCurrent 설치 또는 업데이트';;
        ko:interactive) printf '%s' '터미널에서 이 설치 프로그램을 대화형으로 실행하세요.';;
        ko:continue) printf '%s' '계속하시겠습니까? [y/N] ';;
        ko:package_file) printf '%s' '--package-file 뒤에 기존 패키지를 지정하세요.';;
        ko:unknown_option) printf '%s' '알 수 없는 옵션입니다.';;
        ko:language_required) printf '%s' '--language 뒤에 언어 태그를 지정하세요.';;
        ko:usage) printf '%s' '사용법: bash %1 [--language TAG] [--dry-run|--download-only] [--package-file PATH]';;
        ko:architecture) printf '%s' '이 검증된 패키지에는 x86-64 컴퓨터가 필요합니다.';;
        ko:identify) printf '%s' '이 배포판을 식별할 수 없습니다.';;
        ko:dry_run) printf '%s' '제품: %1 %2
배포판: %3
패키지: %4
SHA256: %5
설치 프로그램: %6';;
        ko:manager) printf '%s' '이 시스템에 %1이(가) 없습니다.';;
        ko:newer) printf '%s' '더 최신 버전의 %1(%2)이(가) 이미 설치되어 있습니다. 해당 버전을 유지했습니다. 이 Linux 설치 프로그램이 제공하는 버전은 %3입니다.';;
        ko:sha_required) printf '%s' 'sha256sum이 필요합니다.';;
        ko:quit) printf '%s' '업데이트하기 전에 «앱 종료»를 사용하여 실행 중인 SoundCurrent 앱을 종료하세요. 창을 닫아도 앱은 계속 실행됩니다.';;
        ko:download_confirm) printf '%s' '%3용 %1 %2을(를) 다운로드하고 검증하시겠습니까? 설치는 수행하지 않습니다.';;
        ko:install_confirm) printf '%s' '%3에 %1 %2을(를) 설치하거나 업데이트하시겠습니까? 프리셋과 프로필은 유지됩니다. 패키지 관리자가 의존 패키지를 설치하고 앱 메뉴 아이콘을 추가합니다. 관리자 승인이 필요합니다. 이퀄라이저는 한 번에 하나만 실행해야 합니다.';;
        ko:download_tool) printf '%s' '먼저 curl 또는 wget을 설치하세요.';;
        ko:verification) printf '%s' '패키지 검증에 실패했습니다. 아무것도 설치하지 않았습니다.';;
        ko:exists) printf '%s' '이미 존재함: %1';;
        ko:saved) printf '%s' '검증된 패키지를 %1에 저장했습니다.';;
        ko:glibc) printf '%s' '이 패키지에는 glibc %1 이상이 필요합니다. 이 시스템의 버전은 %2입니다. 아무것도 설치하지 않았습니다.';;
        ko:installed) printf '%s' '%1 %2을(를) 설치했습니다. 앱 메뉴에서 여세요. 업데이트 후에는 «앱 종료»를 사용하여 종료한 뒤 다시 여세요. 앱 업데이트를 위해 제거하거나 시스템을 재부팅할 필요는 없습니다.';;
        hi:enterprise) printf '%s' 'वर्तमान एंटरप्राइज़ RPM के लिए RHEL 10 या उसका संगत संस्करण 10 आधारित वितरण आवश्यक है।';;
        hi:fedora) printf '%s' 'वर्तमान Fedora पैकेज के लिए Fedora 44 या नया संस्करण आवश्यक है।';;
        hi:unsupported) printf '%s' 'इस वितरण के लिए अभी कोई सत्यापित पैकेज नहीं है। समर्थित बिल्ड के लिए GitHub रिलीज़ पृष्ठ देखें।';;
        hi:installer_title) printf '%s' 'SoundCurrent इंस्टॉलर';;
        hi:install_title) printf '%s' 'SoundCurrent इंस्टॉल या अपडेट करें';;
        hi:interactive) printf '%s' 'इस इंस्टॉलर को टर्मिनल में संवादात्मक रूप से चलाएँ।';;
        hi:continue) printf '%s' 'जारी रखें? [y/N] ';;
        hi:package_file) printf '%s' '--package-file के बाद किसी मौजूदा पैकेज का पथ दें।';;
        hi:unknown_option) printf '%s' 'अज्ञात विकल्प।';;
        hi:language_required) printf '%s' '--language के बाद भाषा टैग दें।';;
        hi:usage) printf '%s' 'उपयोग: bash %1 [--language TAG] [--dry-run|--download-only] [--package-file PATH]';;
        hi:architecture) printf '%s' 'इन सत्यापित पैकेजों के लिए x86-64 कंप्यूटर आवश्यक है।';;
        hi:identify) printf '%s' 'इस वितरण की पहचान नहीं हो सकी।';;
        hi:dry_run) printf '%s' 'उत्पाद: %1 %2
वितरण: %3
पैकेज: %4
SHA256: %5
इंस्टॉलर: %6';;
        hi:manager) printf '%s' 'इस सिस्टम में %1 उपलब्ध नहीं है।';;
        hi:newer) printf '%s' '%1 का नया संस्करण (%2) पहले से इंस्टॉल है। उसे रखा गया है; यह Linux इंस्टॉलर संस्करण %3 प्रदान करता है।';;
        hi:sha_required) printf '%s' 'sha256sum आवश्यक है।';;
        hi:quit) printf '%s' 'अपडेट करने से पहले चल रहे SoundCurrent ऐप को बंद करने के लिए «ऐप से बाहर निकलें» का उपयोग करें। विंडो बंद करने पर ऐप चलता रहता है।';;
        hi:download_confirm) printf '%s' '%3 के लिए %1 %2 डाउनलोड करके सत्यापित करें? इंस्टॉलेशन नहीं किया जाएगा।';;
        hi:install_confirm) printf '%s' '%3 पर %1 %2 इंस्टॉल या अपडेट करें? आपके प्रीसेट और प्रोफ़ाइल सुरक्षित रखे जाएँगे। पैकेज प्रबंधक निर्भरताएँ इंस्टॉल करता है और ऐप मेनू में आइकन जोड़ता है। प्रशासक की अनुमति आवश्यक है। एक समय में केवल एक इक्वलाइज़र चलना चाहिए।';;
        hi:download_tool) printf '%s' 'पहले curl या wget इंस्टॉल करें।';;
        hi:verification) printf '%s' 'पैकेज का सत्यापन विफल हुआ। कुछ भी इंस्टॉल नहीं किया गया।';;
        hi:exists) printf '%s' 'पहले से मौजूद है: %1';;
        hi:saved) printf '%s' 'सत्यापित पैकेज %1 में सहेजा गया।';;
        hi:glibc) printf '%s' 'इस पैकेज के लिए glibc %1 या नया संस्करण आवश्यक है; इस सिस्टम में संस्करण %2 है। कुछ भी इंस्टॉल नहीं किया गया।';;
        hi:installed) printf '%s' '%1 %2 इंस्टॉल हो गया। इसे ऐप मेनू से खोलें। अपडेट के बाद «ऐप से बाहर निकलें» का उपयोग करें और फिर ऐप दोबारा खोलें। ऐप अपडेट के लिए अनइंस्टॉल या सिस्टम रीबूट की आवश्यकता नहीं है।';;
        id:enterprise) printf '%s' 'RPM perusahaan saat ini memerlukan RHEL 10 atau distribusi turunannya yang kompatibel dengan versi 10.';;
        id:fedora) printf '%s' 'Paket Fedora saat ini memerlukan Fedora 44 atau yang lebih baru.';;
        id:unsupported) printf '%s' 'Distribusi ini belum memiliki paket yang telah diverifikasi. Lihat halaman rilis GitHub untuk build yang didukung.';;
        id:installer_title) printf '%s' 'Pemasang SoundCurrent';;
        id:install_title) printf '%s' 'Pasang atau perbarui SoundCurrent';;
        id:interactive) printf '%s' 'Jalankan pemasang ini secara interaktif di terminal.';;
        id:continue) printf '%s' 'Lanjutkan? [y/N] ';;
        id:package_file) printf '%s' 'Tentukan paket yang sudah ada setelah --package-file.';;
        id:unknown_option) printf '%s' 'Opsi tidak dikenal.';;
        id:language_required) printf '%s' 'Tentukan tag bahasa setelah --language.';;
        id:usage) printf '%s' 'Penggunaan: bash %1 [--language TAG] [--dry-run|--download-only] [--package-file PATH]';;
        id:architecture) printf '%s' 'Paket yang telah diverifikasi ini memerlukan komputer x86-64.';;
        id:identify) printf '%s' 'Distribusi ini tidak dapat diidentifikasi.';;
        id:dry_run) printf '%s' 'Produk: %1 %2
Distribusi: %3
Paket: %4
SHA256: %5
Pemasang: %6';;
        id:manager) printf '%s' 'Sistem ini tidak memiliki %1.';;
        id:newer) printf '%s' 'Versi %1 yang lebih baru (%2) sudah terpasang. Versi tersebut dipertahankan; pemasang Linux ini menyediakan versi %3.';;
        id:sha_required) printf '%s' 'sha256sum diperlukan.';;
        id:quit) printf '%s' 'Gunakan «Keluar dari aplikasi» untuk keluar dari aplikasi SoundCurrent yang sedang berjalan sebelum memperbarui. Menutup jendelanya membuat aplikasi tetap berjalan.';;
        id:download_confirm) printf '%s' 'Unduh dan verifikasi %1 %2 untuk %3? Pemasangan tidak akan dilakukan.';;
        id:install_confirm) printf '%s' 'Pasang atau perbarui %1 %2 pada %3? Preset dan profil Anda dipertahankan. Pengelola paket memasang dependensi dan menambahkan ikon ke menu aplikasi. Persetujuan administrator diperlukan. Hanya satu ekualiser yang boleh berjalan pada satu waktu.';;
        id:download_tool) printf '%s' 'Pasang curl atau wget terlebih dahulu.';;
        id:verification) printf '%s' 'Verifikasi paket gagal. Tidak ada yang dipasang.';;
        id:exists) printf '%s' 'Sudah ada: %1';;
        id:saved) printf '%s' 'Paket terverifikasi disimpan ke %1';;
        id:glibc) printf '%s' 'Paket ini memerlukan glibc %1 atau yang lebih baru; sistem ini memiliki versi %2. Tidak ada yang dipasang.';;
        id:installed) printf '%s' '%1 %2 telah dipasang. Buka dari menu aplikasi. Gunakan «Keluar dari aplikasi» dan buka kembali setelah memperbarui. Pembaruan aplikasi tidak memerlukan penghapusan instalasi atau mulai ulang sistem.';;
        vi:enterprise) printf '%s' 'Gói RPM dành cho hệ thống doanh nghiệp hiện tại yêu cầu RHEL 10 hoặc bản phân phối phái sinh tương thích phiên bản 10.';;
        vi:fedora) printf '%s' 'Gói Fedora hiện tại yêu cầu Fedora 44 trở lên.';;
        vi:unsupported) printf '%s' 'Bản phân phối này chưa có gói đã được kiểm tra. Xem trang phát hành trên GitHub để biết các bản dựng được hỗ trợ.';;
        vi:installer_title) printf '%s' 'Trình cài đặt SoundCurrent';;
        vi:install_title) printf '%s' 'Cài đặt hoặc cập nhật SoundCurrent';;
        vi:interactive) printf '%s' 'Chạy trình cài đặt này ở chế độ tương tác trong cửa sổ dòng lệnh.';;
        vi:continue) printf '%s' 'Tiếp tục? [y/N] ';;
        vi:package_file) printf '%s' 'Chỉ định một gói hiện có sau --package-file.';;
        vi:unknown_option) printf '%s' 'Tùy chọn không xác định.';;
        vi:language_required) printf '%s' 'Chỉ định thẻ ngôn ngữ sau --language.';;
        vi:usage) printf '%s' 'Cách dùng: bash %1 [--language TAG] [--dry-run|--download-only] [--package-file PATH]';;
        vi:architecture) printf '%s' 'Các gói đã được kiểm tra này yêu cầu máy tính x86-64.';;
        vi:identify) printf '%s' 'Không thể xác định bản phân phối này.';;
        vi:dry_run) printf '%s' 'Sản phẩm: %1 %2
Bản phân phối: %3
Gói: %4
SHA256: %5
Trình cài đặt: %6';;
        vi:manager) printf '%s' 'Hệ thống này thiếu %1.';;
        vi:newer) printf '%s' 'Phiên bản mới hơn của %1 (%2) đã được cài đặt. Phiên bản đó được giữ lại; trình cài đặt Linux này cung cấp phiên bản %3.';;
        vi:sha_required) printf '%s' 'Cần có sha256sum.';;
        vi:quit) printf '%s' 'Dùng «Thoát ứng dụng» để thoát ứng dụng SoundCurrent đang chạy trước khi cập nhật. Đóng cửa sổ vẫn để ứng dụng tiếp tục chạy.';;
        vi:download_confirm) printf '%s' 'Tải xuống và xác minh %1 %2 cho %3? Sẽ không thực hiện cài đặt.';;
        vi:install_confirm) printf '%s' 'Cài đặt hoặc cập nhật %1 %2 trên %3? Các thiết lập sẵn và hồ sơ của bạn được giữ lại. Trình quản lý gói cài đặt các gói phụ thuộc và thêm biểu tượng vào menu ứng dụng. Cần có sự chấp thuận của quản trị viên. Chỉ nên chạy một bộ cân bằng âm thanh tại một thời điểm.';;
        vi:download_tool) printf '%s' 'Cài đặt curl hoặc wget trước.';;
        vi:verification) printf '%s' 'Xác minh gói thất bại. Không có gì được cài đặt.';;
        vi:exists) printf '%s' 'Đã tồn tại: %1';;
        vi:saved) printf '%s' 'Gói đã xác minh được lưu vào %1';;
        vi:glibc) printf '%s' 'Gói này cần glibc %1 trở lên; hệ thống này có phiên bản %2. Không có gì được cài đặt.';;
        vi:installed) printf '%s' 'Đã cài đặt %1 %2. Mở từ menu ứng dụng. Dùng «Thoát ứng dụng» rồi mở lại sau khi cập nhật. Không cần gỡ cài đặt hoặc khởi động lại hệ thống để cập nhật ứng dụng.';;
        th:enterprise) printf '%s' 'แพ็กเกจ RPM สำหรับระบบองค์กรในปัจจุบันต้องใช้ RHEL 10 หรือดิสทริบิวชันที่พัฒนาต่อยอดและเข้ากันได้กับรุ่น 10';;
        th:fedora) printf '%s' 'แพ็กเกจ Fedora ในปัจจุบันต้องใช้ Fedora 44 หรือใหม่กว่า';;
        th:unsupported) printf '%s' 'ดิสทริบิวชันนี้ยังไม่มีแพ็กเกจที่ผ่านการตรวจสอบ ดูหน้ารุ่นที่เผยแพร่บน GitHub สำหรับบิลด์ที่รองรับ';;
        th:installer_title) printf '%s' 'ตัวติดตั้ง SoundCurrent';;
        th:install_title) printf '%s' 'ติดตั้งหรืออัปเดต SoundCurrent';;
        th:interactive) printf '%s' 'เรียกใช้ตัวติดตั้งนี้ในเทอร์มินัลแบบโต้ตอบ';;
        th:continue) printf '%s' 'ดำเนินการต่อหรือไม่? [y/N] ';;
        th:package_file) printf '%s' 'ระบุแพ็กเกจที่มีอยู่หลัง --package-file';;
        th:unknown_option) printf '%s' 'ไม่รู้จักตัวเลือกนี้';;
        th:language_required) printf '%s' 'ระบุแท็กภาษาหลัง --language';;
        th:usage) printf '%s' 'วิธีใช้: bash %1 [--language TAG] [--dry-run|--download-only] [--package-file PATH]';;
        th:architecture) printf '%s' 'แพ็กเกจที่ผ่านการตรวจสอบเหล่านี้ต้องใช้คอมพิวเตอร์ x86-64';;
        th:identify) printf '%s' 'ไม่สามารถระบุดิสทริบิวชันนี้ได้';;
        th:dry_run) printf '%s' 'ผลิตภัณฑ์: %1 %2
ดิสทริบิวชัน: %3
แพ็กเกจ: %4
SHA256: %5
ตัวติดตั้ง: %6';;
        th:manager) printf '%s' 'ระบบนี้ไม่มี %1';;
        th:newer) printf '%s' 'ติดตั้ง %1 รุ่นใหม่กว่า (%2) ไว้แล้ว โดยเก็บรุ่นนั้นไว้ ตัวติดตั้ง Linux นี้มีรุ่น %3';;
        th:sha_required) printf '%s' 'ต้องมี sha256sum';;
        th:quit) printf '%s' 'ใช้ «ออกจากแอป» เพื่อออกจากแอป SoundCurrent ที่กำลังทำงานก่อนอัปเดต การปิดหน้าต่างจะยังคงให้แอปทำงานต่อ';;
        th:download_confirm) printf '%s' 'ดาวน์โหลดและตรวจสอบ %1 %2 สำหรับ %3 หรือไม่? จะไม่มีการติดตั้ง';;
        th:install_confirm) printf '%s' 'ติดตั้งหรืออัปเดต %1 %2 บน %3 หรือไม่? จะเก็บพรีเซ็ตและโปรไฟล์ของคุณไว้ ตัวจัดการแพ็กเกจจะติดตั้งแพ็กเกจที่จำเป็นและเพิ่มไอคอนในเมนูแอป ต้องได้รับอนุมัติจากผู้ดูแลระบบ ควรใช้งานอีควอไลเซอร์เพียงตัวเดียวในแต่ละครั้ง';;
        th:download_tool) printf '%s' 'ติดตั้ง curl หรือ wget ก่อน';;
        th:verification) printf '%s' 'การตรวจสอบแพ็กเกจล้มเหลว ไม่มีการติดตั้งใด ๆ';;
        th:exists) printf '%s' 'มีอยู่แล้ว: %1';;
        th:saved) printf '%s' 'บันทึกแพ็กเกจที่ผ่านการตรวจสอบไปยัง %1 แล้ว';;
        th:glibc) printf '%s' 'แพ็กเกจนี้ต้องใช้ glibc %1 หรือใหม่กว่า ระบบนี้มีรุ่น %2 ไม่มีการติดตั้งใด ๆ';;
        th:installed) printf '%s' 'ติดตั้ง %1 %2 แล้ว เปิดจากเมนูแอป หลังอัปเดตให้ใช้ «ออกจากแอป» แล้วเปิดใหม่ การอัปเดตแอปไม่ต้องถอนการติดตั้งหรือเริ่มระบบใหม่';;
        sw:enterprise) printf '%s' 'RPM ya sasa ya mifumo ya biashara inahitaji RHEL 10 au usambazaji unaotokana nayo unaooana na toleo la 10.';;
        sw:fedora) printf '%s' 'Kifurushi cha sasa cha Fedora kinahitaji Fedora 44 au toleo jipya zaidi.';;
        sw:unsupported) printf '%s' 'Usambazaji huu bado hauna kifurushi kilichohakikiwa. Angalia matoleo ya GitHub kwa matoleo ya programu yanayotumika.';;
        sw:installer_title) printf '%s' 'Kisakinishi cha SoundCurrent';;
        sw:install_title) printf '%s' 'Sakinisha au sasisha SoundCurrent';;
        sw:interactive) printf '%s' 'Endesha kisakinishi hiki kwa mwingiliano katika terminali.';;
        sw:continue) printf '%s' 'Endelea? [y/N] ';;
        sw:package_file) printf '%s' 'Taja kifurushi kilichopo baada ya --package-file.';;
        sw:unknown_option) printf '%s' 'Chaguo halijulikani.';;
        sw:language_required) printf '%s' 'Taja lebo ya lugha baada ya --language.';;
        sw:usage) printf '%s' 'Matumizi: bash %1 [--language TAG] [--dry-run|--download-only] [--package-file PATH]';;
        sw:architecture) printf '%s' 'Vifurushi hivi vilivyohakikiwa vinahitaji kompyuta ya x86-64.';;
        sw:identify) printf '%s' 'Haiwezekani kutambua usambazaji huu.';;
        sw:dry_run) printf '%s' 'Bidhaa: %1 %2
Usambazaji: %3
Kifurushi: %4
SHA256: %5
Kisakinishi: %6';;
        sw:manager) printf '%s' 'Mfumo huu hauna %1.';;
        sw:newer) printf '%s' 'Toleo jipya zaidi la %1 (%2) tayari limesakinishwa. Limehifadhiwa; kisakinishi hiki cha Linux hutoa toleo la %3.';;
        sw:sha_required) printf '%s' 'sha256sum inahitajika.';;
        sw:quit) printf '%s' 'Tumia «Toka kwenye programu» kuondoka kwenye programu ya SoundCurrent inayoendeshwa kabla ya kusasisha. Kufunga dirisha lake huiacha ikiendelea kuendeshwa.';;
        sw:download_confirm) printf '%s' 'Pakua na hakiki %1 %2 kwa %3? Hakuna usakinishaji utakaofanywa.';;
        sw:install_confirm) printf '%s' 'Sakinisha au sasisha %1 %2 kwenye %3? Mipangilio yako iliyowekwa awali na profaili zitahifadhiwa. Kidhibiti vifurushi husakinisha vitegemezi na kuongeza aikoni kwenye menyu ya programu. Idhini ya msimamizi inahitajika. Kiisawazisha sauti kimoja tu kinapaswa kuendeshwa kwa wakati mmoja.';;
        sw:download_tool) printf '%s' 'Sakinisha curl au wget kwanza.';;
        sw:verification) printf '%s' 'Uhakiki wa kifurushi umeshindwa. Hakuna kilichosakinishwa.';;
        sw:exists) printf '%s' 'Tayari ipo: %1';;
        sw:saved) printf '%s' 'Kifurushi kilichohakikiwa kimehifadhiwa kwenye %1';;
        sw:glibc) printf '%s' 'Kifurushi hiki kinahitaji glibc %1 au toleo jipya zaidi; mfumo huu una toleo la %2. Hakuna kilichosakinishwa.';;
        sw:installed) printf '%s' '%1 %2 imesakinishwa. Ifungue kutoka kwenye menyu ya programu. Tumia «Toka kwenye programu» kisha uifungue tena baada ya kusasisha. Hakuna haja ya kuondoa programu au kuwasha upya mfumo ili kusasisha programu.';;
        *:enterprise) printf '%s' 'The current enterprise RPM requires RHEL 10 or a compatible version 10 derivative.';;
        *:fedora) printf '%s' 'The current Fedora package requires Fedora 44 or newer.';;
        *:unsupported) printf '%s' 'This distribution has no reviewed package yet. See the GitHub releases for supported builds.';;
        *:installer_title) printf '%s' 'SoundCurrent installer';;
        *:install_title) printf '%s' 'Install or update SoundCurrent';;
        *:interactive) printf '%s' 'Run this installer interactively in a terminal.';;
        *:continue) printf '%s' 'Continue? [y/N] ';;
        *:package_file) printf '%s' 'Provide an existing package after --package-file.';;
        *:unknown_option) printf '%s' 'Unknown option.';;
        *:language_required) printf '%s' 'Provide a language tag after --language.';;
        *:usage) printf '%s' 'Usage: bash %1 [--language TAG] [--dry-run|--download-only] [--package-file PATH]';;
        *:architecture) printf '%s' 'These reviewed packages require an x86-64 computer.';;
        *:identify) printf '%s' 'Cannot identify this distribution.';;
        *:dry_run) printf '%s' 'Product: %1 %2
Distribution: %3
Package: %4
SHA256: %5
Installer: %6';;
        *:manager) printf '%s' 'This system is missing %1.';;
        *:newer) printf '%s' 'A newer %1 (%2) is already installed. It was kept; this Linux installer provides %3.';;
        *:sha_required) printf '%s' 'sha256sum is required.';;
        *:quit) printf '%s' 'Use «Quit app» to exit the running SoundCurrent app before updating. Closing its window keeps it running.';;
        *:download_confirm) printf '%s' 'Download and verify %1 %2 for %3? No installation will be performed.';;
        *:install_confirm) printf '%s' 'Install or update %1 %2 on %3? Your presets and profiles are kept. The package manager installs dependencies and adds an app-menu icon. Administrator approval is needed. Only one equalizer should run at a time.';;
        *:download_tool) printf '%s' 'Install curl or wget first.';;
        *:verification) printf '%s' 'Package verification failed. Nothing was installed.';;
        *:exists) printf '%s' 'Already exists: %1';;
        *:saved) printf '%s' 'Verified package saved to %1';;
        *:glibc) printf '%s' 'This package needs glibc %1 or newer; this system has %2. Nothing was installed.';;
        *:installed) printf '%s' 'Installed %1 %2. Open it from the applications menu. Use «Quit app» and reopen after an update. No uninstall or reboot is needed for the app update.';;
        *) return 1;;
    esac
}
# END GENERATED INSTALLER CATALOG
sc_language='en'
sc_language=$(sc_resolve_language "${SC_INSTALLER_LANGUAGE:-${LANGUAGE:-${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}}}")
sc_text() {
    local sc_id=$1 sc_pattern sc_result='' sc_prefix sc_index
    shift
    local -a sc_values=("$@")
    sc_pattern=$(sc_lookup "$sc_id")
    # One-pass substitution: opaque arguments never become code or placeholders.
    while [[ $sc_pattern =~ %([1-9]) ]]; do
        sc_index=$((${BASH_REMATCH[1]} - 1))
        sc_prefix=${sc_pattern%%\%[1-9]*}
        sc_pattern=${sc_pattern:${#sc_prefix}+2}
        sc_result+="$sc_prefix${sc_values[sc_index]:-}"
    done
    printf '%s' "$sc_result$sc_pattern"
}
sc_error() { sc_text "$@"; printf '\n'; }
select_package() {
    local id=$1 like=$2 major=${3%%.*}
    case " $id $like " in
        *' debian '*|*' ubuntu '*)
            manager=apt-get; filename="${product}_${version}_amd64.deb"; expected=$deb_hash ;;
        *' rhel '*|*' centos '*|*' rocky '*|*' almalinux '*)
            if ! [[ $major =~ ^[0-9]+$ ]] || ((major < 10)); then sc_error enterprise >&2; return 1; fi
            manager=dnf; filename="${product}-${version}-1.el10.x86_64.rpm"; expected=$rhel_hash ;;
        *' fedora '*)
            if ! [[ $major =~ ^[0-9]+$ ]] || ((major < 44)); then sc_error fedora >&2; return 1; fi
            manager=dnf; filename="${product}-${version}-1.fc44.x86_64.rpm"; expected=$fedora_hash ;;
        *) sc_error unsupported >&2; return 1 ;;
    esac
}
message() {
    if [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] && command -v zenity >/dev/null; then
        zenity --info --title="$(sc_text installer_title)" --text="$1"
    elif [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] && command -v kdialog >/dev/null; then
        kdialog --title "$(sc_text installer_title)" --msgbox "$1"
    else printf '%s\n' "$1"; fi
}
confirm() {
    if [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] && command -v zenity >/dev/null; then
        zenity --question --title="$(sc_text install_title)" --text="$1"
    elif [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] && command -v kdialog >/dev/null; then
        kdialog --title "$(sc_text install_title)" --yesno "$1"
    else
        [[ -t 0 ]] || { sc_error interactive >&2; return 1; }
        printf '%s\n%s' "$1" "$(sc_text continue)"; local answer; read -r answer
        [[ $answer == y || $answer == Y ]]
    fi
}
main() {
    local mode=install package_file=''
    while (($#)); do
        case "$1" in
            install|--dry-run|--download-only|--help) mode=$1; shift ;;
            --language)
                [[ $# -ge 2 ]] || { sc_error language_required >&2; return 2; }
                sc_language=$(sc_resolve_language "$2"); shift 2 ;;
            --package-file)
                [[ $# -ge 2 && -f $2 ]] || { sc_error package_file >&2; return 2; }
                package_file=$(realpath -- "$2"); shift 2 ;;
            *) sc_error unknown_option >&2; return 2 ;;
        esac
    done
    case "$mode" in install|--dry-run|--download-only) ;; --help)
        sc_text usage "$0"; printf '\n'; return;; *) sc_error unknown_option >&2; return 2;; esac
    [[ $(uname -m) == x86_64 ]] || { sc_error architecture >&2; return 1; }
    [[ -r /etc/os-release ]] || { sc_error identify >&2; return 1; }
    # shellcheck source=/dev/null
    source /etc/os-release
    select_package "${ID:-}" "${ID_LIKE:-}" "${VERSION_ID:-}"
    local url="https://github.com/$repo/releases/download/$release/$filename"
    if [[ $mode == --dry-run ]]; then sc_text dry_run "$product" "$version" "${PRETTY_NAME:-$ID}" "$url" "$expected" "$manager"; printf '\n' ; return; fi
    command -v "$manager" >/dev/null || { sc_error manager "$manager" >&2; return 1; }
    if [[ $mode == install ]]; then
        local installed='' status=''
        if [[ $manager == apt-get ]]; then
            status=$(dpkg-query -W -f='${Status} ${Version}' "$product" 2>/dev/null || true)
            if [[ $status == 'install ok installed '* ]]; then installed=${status##* }; fi
        else installed=$(rpm -q --qf '%{VERSION}' "$product" 2>/dev/null || true); fi
        [[ $installed =~ ^[0-9] ]] || installed=''
        if [[ -n $installed && $installed != "$version" && $(printf '%s\n%s\n' "$installed" "$version" | sort -V | tail -1) == "$installed" ]]; then
            message "$(sc_text newer "$product" "$installed" "$version")"; return 0
        fi
    fi
    command -v sha256sum >/dev/null || { sc_error sha_required >&2; return 1; }
    if [[ $mode == install ]] && { pgrep -x soundcurrent-eq >/dev/null || pgrep -f '(^|/)soundcurrent-studio([[:space:]]|$)' >/dev/null; }; then
        message "$(sc_text quit)"; return 1
    fi
    if [[ $mode == --download-only ]]; then
        confirm "$(sc_text download_confirm "$product" "$version" "${PRETTY_NAME:-$ID}")" || return 0
    else
    confirm "$(sc_text install_confirm "$product" "$version" "${PRETTY_NAME:-$ID}")" || return 0
    fi
    install_work=$(mktemp -d)
    trap 'rm -rf -- "$install_work"' EXIT
    local work=$install_work
    local package="$work/$filename"
    if [[ -n $package_file ]]; then cp -- "$package_file" "$package"
    elif command -v curl >/dev/null; then curl --fail --location --proto '=https' --proto-redir '=https' --tlsv1.2 --retry 2 --output "$package" "$url"
    elif command -v wget >/dev/null; then wget --https-only -O "$package" "$url"
    else sc_error download_tool >&2; return 1; fi
    printf '%s  %s\n' "$expected" "$package" | sha256sum --check --status || { message "$(sc_text verification)"; return 1; }
    if [[ $mode == --download-only ]]; then
        local destination="${XDG_DOWNLOAD_DIR:-$HOME/Downloads}/$filename"
        mkdir -p -- "$(dirname "$destination")"
        [[ ! -e $destination ]] || { sc_error exists "$destination" >&2; return 1; }
        cp -- "$package" "$destination"; message "$(sc_text saved "$destination")"; return
    fi
    # Reject binaries requiring a newer C library before changing the machine.
    if [[ $manager == apt-get ]]; then
        local required actual
        dpkg-deb -x "$package" "$work/check"
        required=$(grep -aoE 'GLIBC_[0-9]+\.[0-9]+' "$work/check/usr/bin/$product" | sort -Vu | tail -1)
        actual=$(getconf GNU_LIBC_VERSION); actual=${actual##* }
        required=${required#GLIBC_}
        if [[ -n $required && $(printf '%s\n%s\n' "$required" "$actual" | sort -V | tail -1) != "$actual" ]]; then
            message "$(sc_text glibc "$required" "$actual")"; return 1
        fi
    fi
    local -a install_command=("$manager" install -y "$package")
    if ((EUID == 0)); then "${install_command[@]}"
    elif [[ ! -t 0 ]] && command -v pkexec >/dev/null; then pkexec "$(command -v "$manager")" install -y "$package"
    else sudo "${install_command[@]}"; fi
    message "$(sc_text installed "$product" "$version")"
}
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
