#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-only
set -euo pipefail
product='soundcurrent-eq'
version='1.0.0'
release='v1.0.0'
repo="rhamenator/$product"
# Published, reviewed package hashes; never execute an unverified download.
deb_hash='cd02a665e53cb28c21e1f37dd0b8a3c02804e0a6dcab8d30a063303e1d64e04f'
fedora_hash='1c43544ff97a66c7191b5ce5f80a9775d2ce751fb410fa81b79e025901112cf6'
rhel_hash='fabb86c8c6c7a7dcc266259f31fe342346b608f7c9f2afdeab80d05d6591b41c'
select_package() {
    local id=$1 like=$2 major=${3%%.*}
    case " $id $like " in
        *' debian '*|*' ubuntu '*)
            manager=apt-get; filename="${product}_${version}_amd64.deb"; expected=$deb_hash ;;
        *' rhel '*|*' centos '*|*' rocky '*|*' almalinux '*)
            if ! [[ $major =~ ^[0-9]+$ ]] || ((major < 10)); then echo 'The current enterprise RPM requires RHEL 10 or a compatible version 10 derivative.' >&2; return 1; fi
            manager=dnf; filename="${product}-${version}-1.el10.x86_64.rpm"; expected=$rhel_hash ;;
        *' fedora '*)
            if ! [[ $major =~ ^[0-9]+$ ]] || ((major < 44)); then echo 'The current Fedora package requires Fedora 44 or newer.' >&2; return 1; fi
            manager=dnf; filename="${product}-${version}-1.fc44.x86_64.rpm"; expected=$fedora_hash ;;
        *) echo 'This distribution has no reviewed package yet. See the GitHub releases for supported builds.' >&2; return 1 ;;
    esac
}
message() {
    if [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] && command -v zenity >/dev/null; then
        zenity --info --title='SoundCurrent installer' --text="$1"
    elif [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] && command -v kdialog >/dev/null; then
        kdialog --title 'SoundCurrent installer' --msgbox "$1"
    else printf '%s\n' "$1"; fi
}
confirm() {
    if [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] && command -v zenity >/dev/null; then
        zenity --question --title='Install or update SoundCurrent' --text="$1"
    elif [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] && command -v kdialog >/dev/null; then
        kdialog --title 'Install or update SoundCurrent' --yesno "$1"
    else
        [[ -t 0 ]] || { echo 'Run this installer interactively in a terminal.' >&2; return 1; }
        printf '%s\nContinue? [y/N] ' "$1"; local answer; read -r answer
        [[ $answer == y || $answer == Y ]]
    fi
}
main() {
    local mode=install package_file=''
    while (($#)); do
        case "$1" in
            install|--dry-run|--download-only|--help) mode=$1; shift ;;
            --package-file)
                [[ $# -ge 2 && -f $2 ]] || { echo 'Provide an existing package after --package-file.' >&2; return 2; }
                package_file=$(realpath -- "$2"); shift 2 ;;
            *) echo 'Unknown option.' >&2; return 2 ;;
        esac
    done
    case "$mode" in install|--dry-run|--download-only) ;; --help)
        echo "Usage: bash $0 [--dry-run|--download-only] [--package-file PATH]"; return;; *) echo 'Unknown option.' >&2; return 2;; esac
    [[ $(uname -m) == x86_64 ]] || { echo 'These reviewed packages require an x86-64 computer.' >&2; return 1; }
    [[ -r /etc/os-release ]] || { echo 'Cannot identify this distribution.' >&2; return 1; }
    # shellcheck source=/dev/null
    source /etc/os-release
    select_package "${ID:-}" "${ID_LIKE:-}" "${VERSION_ID:-}"
    local url="https://github.com/$repo/releases/download/$release/$filename"
    if [[ $mode == --dry-run ]]; then printf 'Product: %s %s\nDistribution: %s\nPackage: %s\nSHA256: %s\nInstaller: %s\n' "$product" "$version" "${PRETTY_NAME:-$ID}" "$url" "$expected" "$manager"; return; fi
    command -v "$manager" >/dev/null || { echo "This system is missing $manager." >&2; return 1; }
    if [[ $mode == install ]]; then
        local installed='' status=''
        if [[ $manager == apt-get ]]; then
            status=$(dpkg-query -W -f='${Status} ${Version}' "$product" 2>/dev/null || true)
            if [[ $status == 'install ok installed '* ]]; then installed=${status##* }; fi
        else installed=$(rpm -q --qf '%{VERSION}' "$product" 2>/dev/null || true); fi
        [[ $installed =~ ^[0-9] ]] || installed=''
        if [[ -n $installed && $installed != "$version" && $(printf '%s\n%s\n' "$installed" "$version" | sort -V | tail -1) == "$installed" ]]; then
            message "A newer $product ($installed) is already installed. It was kept; this Linux installer provides $version."; return 0
        fi
    fi
    command -v sha256sum >/dev/null || { echo 'sha256sum is required.' >&2; return 1; }
    if [[ $mode == install ]] && { pgrep -x soundcurrent-eq >/dev/null || pgrep -f '(^|/)soundcurrent-studio([[:space:]]|$)' >/dev/null; }; then
        message 'Use Quit to exit the running SoundCurrent app before updating. Closing its window keeps it running.'; return 1
    fi
    if [[ $mode == --download-only ]]; then
        confirm "Download and verify $product $version for ${PRETTY_NAME:-$ID}? No installation will be performed." || return 0
    else
    confirm "Install or update $product $version on ${PRETTY_NAME:-$ID}? Your presets and profiles are kept. The package manager installs dependencies and adds an app-menu icon. Administrator approval is needed. Only one equalizer should run at a time." || return 0
    fi
    install_work=$(mktemp -d)
    trap 'rm -rf -- "$install_work"' EXIT
    local work=$install_work
    local package="$work/$filename"
    if [[ -n $package_file ]]; then cp -- "$package_file" "$package"
    elif command -v curl >/dev/null; then curl --fail --location --proto '=https' --proto-redir '=https' --tlsv1.2 --retry 2 --output "$package" "$url"
    elif command -v wget >/dev/null; then wget --https-only -O "$package" "$url"
    else echo 'Install curl or wget first.' >&2; return 1; fi
    printf '%s  %s\n' "$expected" "$package" | sha256sum --check --status || { message 'Package verification failed. Nothing was installed.'; return 1; }
    if [[ $mode == --download-only ]]; then
        local destination="${XDG_DOWNLOAD_DIR:-$HOME/Downloads}/$filename"
        mkdir -p -- "$(dirname "$destination")"
        [[ ! -e $destination ]] || { echo "Already exists: $destination" >&2; return 1; }
        cp -- "$package" "$destination"; message "Verified package saved to $destination"; return
    fi
    # Reject binaries requiring a newer C library before changing the machine.
    if [[ $manager == apt-get ]]; then
        local required actual
        dpkg-deb -x "$package" "$work/check"
        required=$(grep -aoE 'GLIBC_[0-9]+\.[0-9]+' "$work/check/usr/bin/$product" | sort -Vu | tail -1)
        actual=$(getconf GNU_LIBC_VERSION); actual=${actual##* }
        required=${required#GLIBC_}
        if [[ -n $required && $(printf '%s\n%s\n' "$required" "$actual" | sort -V | tail -1) != "$actual" ]]; then
            message "This package needs glibc $required or newer; this system has $actual. Nothing was installed."; return 1
        fi
    fi
    local -a install_command=("$manager" install -y "$package")
    if ((EUID == 0)); then "${install_command[@]}"
    elif [[ ! -t 0 ]] && command -v pkexec >/dev/null; then pkexec "$(command -v "$manager")" install -y "$package"
    else sudo "${install_command[@]}"; fi
    message "Installed $product $version. Open it from the applications menu. Use Quit and reopen after an update. No uninstall or reboot is needed for the app update."
}
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
