# END GENERATED INSTALLER CATALOG
sc_language='en'
sc_language=$(sc_resolve_language "${SC_INSTALLER_LANGUAGE:-${LANGUAGE:-${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}}}")
sc_text() {
    local sc_id=$1 sc_pattern sc_result='' sc_prefix sc_index
    shift
    local -a sc_values=("$@")
    sc_pattern=$(sc_lookup "$sc_id")
    # One-pass substitution: opaque arguments never become code or placeholders.
    while [[ $sc_pattern =~ %([1-9]) ]]; do
        sc_index=$((${BASH_REMATCH[1]} - 1))
        sc_prefix=${sc_pattern%%\%[1-9]*}
        sc_pattern=${sc_pattern:${#sc_prefix}+2}
        sc_result+="$sc_prefix${sc_values[sc_index]:-}"
    done
    printf '%s' "$sc_result$sc_pattern"
}
sc_error() { sc_text "$@"; printf '\n'; }
select_package() {
    local id=$1 like=$2 major=${3%%.*}
    case " $id $like " in
        *' debian '*|*' ubuntu '*)
            manager=apt-get; filename="${product}_${version}_amd64.deb"; expected=$deb_hash ;;
        *' rhel '*|*' centos '*|*' rocky '*|*' almalinux '*)
            if ! [[ $major =~ ^[0-9]+$ ]] || ((major < 10)); then sc_error enterprise >&2; return 1; fi
            manager=dnf; filename="${product}-${version}-1.el10.x86_64.rpm"; expected=$rhel_hash ;;
        *' fedora '*)
            if ! [[ $major =~ ^[0-9]+$ ]] || ((major < 44)); then sc_error fedora >&2; return 1; fi
            manager=dnf; filename="${product}-${version}-1.fc44.x86_64.rpm"; expected=$fedora_hash ;;
        *) sc_error unsupported >&2; return 1 ;;
    esac
}
message() {
    if [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] && command -v zenity >/dev/null; then
        zenity --info --title="$(sc_text installer_title)" --text="$1"
    elif [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] && command -v kdialog >/dev/null; then
        kdialog --title "$(sc_text installer_title)" --msgbox "$1"
    else printf '%s\n' "$1"; fi
}
confirm() {
    if [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] && command -v zenity >/dev/null; then
        zenity --question --title="$(sc_text install_title)" --text="$1"
    elif [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] && command -v kdialog >/dev/null; then
        kdialog --title "$(sc_text install_title)" --yesno "$1"
    else
        [[ -t 0 ]] || { sc_error interactive >&2; return 1; }
        printf '%s\n%s' "$1" "$(sc_text continue)"; local answer; read -r answer
        [[ $answer == y || $answer == Y ]]
    fi
}
main() {
    local mode=install package_file=''
    while (($#)); do
        case "$1" in
            install|--dry-run|--download-only|--help) mode=$1; shift ;;
            --language)
                [[ $# -ge 2 ]] || { sc_error language_required >&2; return 2; }
                sc_language=$(sc_resolve_language "$2"); shift 2 ;;
            --package-file)
                [[ $# -ge 2 && -f $2 ]] || { sc_error package_file >&2; return 2; }
                package_file=$(realpath -- "$2"); shift 2 ;;
            *) sc_error unknown_option >&2; return 2 ;;
        esac
    done
    case "$mode" in install|--dry-run|--download-only) ;; --help)
        sc_text usage "$0"; printf '\n'; return;; *) sc_error unknown_option >&2; return 2;; esac
    [[ $(uname -m) == x86_64 ]] || { sc_error architecture >&2; return 1; }
    [[ -r /etc/os-release ]] || { sc_error identify >&2; return 1; }
    # shellcheck source=/dev/null
    source /etc/os-release
    select_package "${ID:-}" "${ID_LIKE:-}" "${VERSION_ID:-}"
    local url="https://github.com/$repo/releases/download/$release/$filename"
    if [[ $mode == --dry-run ]]; then sc_text dry_run "$product" "$version" "${PRETTY_NAME:-$ID}" "$url" "$expected" "$manager"; printf '\n' ; return; fi
    command -v "$manager" >/dev/null || { sc_error manager "$manager" >&2; return 1; }
    if [[ $mode == install ]]; then
        local installed='' status=''
        if [[ $manager == apt-get ]]; then
            status=$(dpkg-query -W -f='${Status} ${Version}' "$product" 2>/dev/null || true)
            if [[ $status == 'install ok installed '* ]]; then installed=${status##* }; fi
        else installed=$(rpm -q --qf '%{VERSION}' "$product" 2>/dev/null || true); fi
        [[ $installed =~ ^[0-9] ]] || installed=''
        if [[ -n $installed && $installed != "$version" && $(printf '%s\n%s\n' "$installed" "$version" | sort -V | tail -1) == "$installed" ]]; then
            message "$(sc_text newer "$product" "$installed" "$version")"; return 0
        fi
    fi
    command -v sha256sum >/dev/null || { sc_error sha_required >&2; return 1; }
    if [[ $mode == install ]] && { pgrep -x soundcurrent-eq >/dev/null || pgrep -f '(^|/)soundcurrent-studio([[:space:]]|$)' >/dev/null; }; then
        message "$(sc_text quit)"; return 1
    fi
    if [[ $mode == --download-only ]]; then
        confirm "$(sc_text download_confirm "$product" "$version" "${PRETTY_NAME:-$ID}")" || return 0
    else
    confirm "$(sc_text install_confirm "$product" "$version" "${PRETTY_NAME:-$ID}")" || return 0
    fi
    install_work=$(mktemp -d)
    trap 'rm -rf -- "$install_work"' EXIT
    local work=$install_work
    local package="$work/$filename"
    if [[ -n $package_file ]]; then cp -- "$package_file" "$package"
    elif command -v curl >/dev/null; then curl --fail --location --proto '=https' --proto-redir '=https' --tlsv1.2 --retry 2 --output "$package" "$url"
    elif command -v wget >/dev/null; then wget --https-only -O "$package" "$url"
    else sc_error download_tool >&2; return 1; fi
    printf '%s  %s\n' "$expected" "$package" | sha256sum --check --status || { message "$(sc_text verification)"; return 1; }
    if [[ $mode == --download-only ]]; then
        local destination="${XDG_DOWNLOAD_DIR:-$HOME/Downloads}/$filename"
        mkdir -p -- "$(dirname "$destination")"
        [[ ! -e $destination ]] || { sc_error exists "$destination" >&2; return 1; }
        cp -- "$package" "$destination"; message "$(sc_text saved "$destination")"; return
    fi
    # Reject binaries requiring a newer C library before changing the machine.
    if [[ $manager == apt-get ]]; then
        local required actual
        dpkg-deb -x "$package" "$work/check"
        required=$(grep -aoE 'GLIBC_[0-9]+\.[0-9]+' "$work/check/usr/bin/$product" | sort -Vu | tail -1)
        actual=$(getconf GNU_LIBC_VERSION); actual=${actual##* }
        required=${required#GLIBC_}
        if [[ -n $required && $(printf '%s\n%s\n' "$required" "$actual" | sort -V | tail -1) != "$actual" ]]; then
            message "$(sc_text glibc "$required" "$actual")"; return 1
        fi
    fi
    local -a install_command=("$manager" install -y "$package")
    if ((EUID == 0)); then "${install_command[@]}"
    elif [[ ! -t 0 ]] && command -v pkexec >/dev/null; then pkexec "$(command -v "$manager")" install -y "$package"
    else sudo "${install_command[@]}"; fi
    message "$(sc_text installed "$product" "$version")"
}
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
