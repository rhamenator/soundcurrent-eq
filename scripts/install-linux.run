# BEGIN GENERATED INSTALLER CATALOG
# Generated from data/localization/linux-installer.json; do not edit this block.
sc_resolve_language() {
    local sc_requested=$1 sc_tag sc_base
    local -a sc_candidates
    IFS=: read -r -a sc_candidates <<< "$sc_requested"
    for sc_tag in "${sc_candidates[@]}"; do
        sc_tag=${sc_tag%%.*}; sc_tag=${sc_tag%%@*}
        sc_tag=$(printf '%s' "$sc_tag" | LC_ALL=C tr 'A-Z_' 'a-z-')
        case "$sc_tag" in zh|zh-cn|zh-sg) sc_tag=zh-hans;; zh-tw|zh-hk|zh-mo) sc_tag=zh-hant;; esac
        for sc_base in "$sc_tag" "${sc_tag%%-*}"; do
            case "$sc_base" in
                en) printf '%s' en; return;;
                fr) printf '%s' fr; return;;
                ar) printf '%s' ar; return;;
                nn) printf '%s' nn; return;;
                de) printf '%s' de; return;;
                es) printf '%s' es; return;;
                it) printf '%s' it; return;;
                pt-pt) printf '%s' pt-PT; return;;
                pt-br) printf '%s' pt-BR; return;;
                nl) printf '%s' nl; return;;
                ro) printf '%s' ro; return;;
                hu) printf '%s' hu; return;;
                pl) printf '%s' pl; return;;
                cs) printf '%s' cs; return;;
                sk) printf '%s' sk; return;;
                sv) printf '%s' sv; return;;
                da) printf '%s' da; return;;
                nb) printf '%s' nb; return;;
                fi) printf '%s' fi; return;;
                el) printf '%s' el; return;;
                tr) printf '%s' tr; return;;
                uk) printf '%s' uk; return;;
                ru) printf '%s' ru; return;;
                he) printf '%s' he; return;;
                fa) printf '%s' fa; return;;
            esac
        done
    done
    printf '%s' en
}
