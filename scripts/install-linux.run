        *:glibc) printf '%s' 'This package needs glibc %1 or newer; this system has %2. Nothing was installed.';;
        *:installed) printf '%s' 'Installed %1 %2. Open it from the applications menu. Use «Quit app» and reopen after an update. No uninstall or reboot is needed for the app update.';;
