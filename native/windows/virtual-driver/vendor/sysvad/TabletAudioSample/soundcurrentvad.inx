[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=10/06/2026,1.0.0.0
CatalogFile=soundcurrentvad.cat
PnpLockDown=1
[Manufacturer]
%Provider%=SoundCurrent,NT$ARCH$.10.0...22621
[SoundCurrent.NT$ARCH$.10.0...22621]
%DeviceName%=SoundCurrent,Root\SOUNDCURRENTVAD
[SourceDisksNames]
1=%DeviceName%
[SourceDisksFiles]
soundcurrentvad.sys=1
[DestinationDirs]
DriverCopy=13
[DriverCopy]
soundcurrentvad.sys
[SoundCurrent.NT]
CopyFiles=DriverCopy
AddReg=DriverRegistry
[DriverRegistry]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,soundcurrentvad.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceName%
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceName%
[SoundCurrent.NT.Interfaces]
AddInterface=%AudioCategory%,WaveSoundCurrent,WaveInterface
AddInterface=%RenderCategory%,WaveSoundCurrent,WaveInterface
AddInterface=%RealtimeCategory%,WaveSoundCurrent,WaveInterface
AddInterface=%AudioCategory%,TopologySoundCurrent,TopologyInterface
AddInterface=%TopologyCategory%,TopologySoundCurrent,TopologyInterface
AddInterface=%AudioCategory%,WaveSoundCurrentMicFeed,MicFeedWaveInterface
AddInterface=%RenderCategory%,WaveSoundCurrentMicFeed,MicFeedWaveInterface
AddInterface=%RealtimeCategory%,WaveSoundCurrentMicFeed,MicFeedWaveInterface
AddInterface=%AudioCategory%,TopologySoundCurrentMicFeed,MicFeedTopologyInterface
AddInterface=%TopologyCategory%,TopologySoundCurrentMicFeed,MicFeedTopologyInterface
AddInterface=%AudioCategory%,WaveSoundCurrentMic,MicWaveInterface
AddInterface=%CaptureCategory%,WaveSoundCurrentMic,MicWaveInterface
AddInterface=%RealtimeCategory%,WaveSoundCurrentMic,MicWaveInterface
AddInterface=%AudioCategory%,TopologySoundCurrentMic,MicTopologyInterface
AddInterface=%TopologyCategory%,TopologySoundCurrentMic,MicTopologyInterface
[WaveInterface]
AddReg=WaveRegistry
[WaveRegistry]
HKR,,CLSID,,%ProxyCLSID%
HKR,,FriendlyName,,%DeviceName%
[TopologyInterface]
AddReg=TopologyRegistry
[TopologyRegistry]
HKR,,CLSID,,%ProxyCLSID%
HKR,,FriendlyName,,%DeviceName%
HKR,EP\0,%EndpointAssociation%,,%AnyNode%
HKR,EP\0,%EventDriven%,0x00010001,1
[MicFeedWaveInterface]
AddReg=MicFeedWaveRegistry
[MicFeedWaveRegistry]
HKR,,CLSID,,%ProxyCLSID%
HKR,,FriendlyName,,%MicFeedName%
[MicFeedTopologyInterface]
AddReg=MicFeedTopologyRegistry
[MicFeedTopologyRegistry]
HKR,,CLSID,,%ProxyCLSID%
HKR,,FriendlyName,,%MicFeedName%
HKR,EP\0,%EndpointAssociation%,,%AnyNode%
HKR,EP\0,%EventDriven%,0x00010001,1
[MicWaveInterface]
AddReg=MicWaveRegistry
[MicWaveRegistry]
HKR,,CLSID,,%ProxyCLSID%
HKR,,FriendlyName,,%MicName%
[MicTopologyInterface]
AddReg=MicTopologyRegistry
[MicTopologyRegistry]
HKR,,CLSID,,%ProxyCLSID%
HKR,,FriendlyName,,%MicName%
HKR,EP\0,%EndpointAssociation%,,%AnyNode%
HKR,EP\0,%EventDriven%,0x00010001,1
[SoundCurrent.NT.Services]
AddService=SoundCurrentVAD,0x00000002,DriverService
[DriverService]
DisplayName=%DeviceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\soundcurrentvad.sys
[SoundCurrent.NT.HW]
AddReg=DeviceRegistry
[DeviceRegistry]
HKR,,DeviceType,0x00010001,0x0000001D
; Audio clients need read/write access; no custom privileged control IOCTLs.
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"
[SoundCurrent.NT.Wdf]
KmdfService=SoundCurrentVAD,WdfSection
[WdfSection]
KmdfLibraryVersion=$KMDFVERSION$
